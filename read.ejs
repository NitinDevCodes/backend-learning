<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full h-full bg-zinc-900 p-10 text-white">
        <div class="nav mb-10">
            <a href="/" class="px-5 py-3 border-2 rounded border-zinc-600 bg-transparent text-white placeholder:text-zinc-500 bg-blue-500 hover:bg-blue-600 transition-colors">Home</a>
        </div>
        <h1 class="text-3xl tracking-tighter font-bold mb-5">All Users</h1>
        <div class="users flex gap-5 flex-wrap">
            <% if(users.length > 0) { %>
                <% users.forEach(function(user) { %>
                <div class="user w-72 p-4 bg-zinc-800 rounded-lg shadow-lg">
                    <div class="w-full h-52 rounded-lg bg-zinc-700 overflow-hidden">
                        <img src="<%= user.image %>" alt="<%= user.name %>" class="w-full h-full object-cover rounded-lg">
                    </div>
                    <h3 class="text-xl font-bold mt-3"><%= user.name %></h3>
                    <h5 class="text-zinc-500"><%= user.email %></h5>
                    <div class="flex gap-3 mt-4">
                        <a href="/edit/<%= user._id %>" class="px-4 py-2 bg-blue-500 hover:bg-blue-600 rounded transition-colors">Edit</a>
                        <a href="/delete/<%= user._id %>" class="px-4 py-2 bg-red-500 hover:bg-red-600 rounded transition-colors">Delete</a>
                    </div>
                </div>
            <% }) %>
            <% } else { %>
                <h3 class="text-xl font-bold mt-3">No Users Found</h3>
            <% } %>
        </div>
    </div>
</body>
</html>